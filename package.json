{
  "name": "music-player-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop music player with hot pink theme",
  "author": "Dev",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win",
    "start": "electron ."
  },
  "build": {
    "appId": "com.musicplayer.desktop",
    "productName": "My Music Player",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "out/**/*"
    ]
  },
  "dependencies": {
    "music-metadata": "^10.6.5",
    "node-id3": "^0.2.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "vite": "^6.3.5",
    "vue": "^3.5.42"
  }
}
